+    const replies={listwallets:['wallet A','wallet B'],getswapnetworkinfo:{automatic_spend_atoms:'0'},getswapreadiness:{ready:true},getswapmode:{mode:'taker',discovery_enabled:true},getswapauthinfo:{principal:'owner:cookie'},

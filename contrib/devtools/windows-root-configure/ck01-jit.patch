+namespace {
+void RemoveIncompletePayload(const std::string& path)
+{
+#ifdef _WIN32
+    // The Windows CRT cannot unlink the read-only payload created with mode 0444.
+    if (::unlink(path.c_str()) == 0 || errno != EACCES) return;
+    if (::_chmod(path.c_str(), _S_IREAD | _S_IWRITE) != 0) return;
+#endif
+    ::unlink(path.c_str());
+}

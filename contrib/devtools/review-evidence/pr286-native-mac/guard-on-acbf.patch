+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn only_a_sole_scheme_url_is_left_to_the_deep_link_plugin() {
+        let args = |v: &[&str]| v.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        let sole = cfg!(any(windows, target_os = "linux"));
+        assert_eq!(
+            plugin_forwards(&args(&["atlas", "btx:addr?amount=0.2"])),

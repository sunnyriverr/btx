+      COMMAND "${BTX_XCRUN_EXECUTABLE}" -sdk macosx metal -std=metal4.0 -c "${BTX_METAL4_PROBE_SRC}" -o "${CMAKE_CURRENT_BINARY_DIR}/btx_metal4_probe.air"

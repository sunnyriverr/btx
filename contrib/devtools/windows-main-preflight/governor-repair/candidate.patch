+#ifdef MODELNET_MODELD_PATH
+namespace {
+void WriteGovernorControl(const fs::path& path, const std::string& text)
+{
+    std::ofstream out(path, std::ios::binary | std::ios::trunc);
+    out << text;
+    out.close();
+    BOOST_REQUIRE(out.good());
+}

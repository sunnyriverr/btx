      "changes": 23,
      "blob_url": "https://github.com/sunnyriverr/btx/blob/6d719e9191cea74a2e5ba7081e6beb02d7fd38bd/contrib%2Fdevtools%2Fsession3-installed-desktop-acceptance%2Fgui.py",

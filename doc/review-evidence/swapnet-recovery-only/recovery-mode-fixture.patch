+def assert_recovery_lock(node):
+    mode = node.rpc("getswapmode")
+    assert mode["mode"] == "recovery" and mode["startup_recovery_lock"] is True
+    assert mode["existing_obligations_recovery_enabled"] is True
+    assert mode["new_trades_enabled"] is False and mode["making_enabled"] is False
+    assert node.rpc("getswapnetworkinfo")["automatic_spend_atoms"] == "0"
+    for desired in ("taker", "maker"):
+        try:
+            node.rpc("setswapmode", {"mode": desired})
+        except RPCError as error:
+            assert "MODE_LOCKED:" in str(error), error
+        else:
+            raise AssertionError("Recovery-only allowed a switch to " + desired)
+    assert node.rpc("getswapmode") == mode

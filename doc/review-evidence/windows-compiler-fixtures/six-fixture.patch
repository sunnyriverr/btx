+    BOOST_CHECK(result.limits_applied);
+    BOOST_CHECK_EQUAL(result.child_status, 1);
+    BOOST_CHECK(err.empty());
+    BOOST_CHECK(helper_preserved);
+    BOOST_CHECK(!fs::exists(root));
+}

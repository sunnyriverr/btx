+            if db.execute("SELECT 1 FROM sn_operations WHERE swap_id=?", (sid,)).fetchone():
+                return False
+            if db.execute("SELECT 1 FROM coinlocks WHERE reservation_id=?", (rid,)).fetchone():
+                return False
+            grant = db.execute(

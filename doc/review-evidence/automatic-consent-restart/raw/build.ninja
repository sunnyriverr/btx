build src/secp256k1/lib/libsecp256k1.a: C_STATIC_LIBRARY_LINKER__secp256k1_Release src/secp256k1/src/CMakeFiles/secp256k1_precomputed.dir/precomputed_ecmult.c.o src/secp256k1/src/CMakeFiles/secp256k1_precomputed.dir/precomputed_ecmult_gen.c.o src/secp256k1/src/CMakeFiles/secp256k1.dir/secp256k1.c.o || src/secp256k1/src/secp256k1_precomputed

build src/secp256k1/src/CMakeFiles/secp256k1.dir/secp256k1.c.o: C_COMPILER__secp256k1_unscanned_Release /home/runner/work/btx/btx/consent-product/src/secp256k1/src/secp256k1.c || cmake_object_order_depends_target_secp256k1
  DEFINES = -DCOMB_BLOCKS=43 -DCOMB_TEETH=6 -DECMULT_WINDOW_SIZE=15 -DENABLE_MODULE_ELLSWIFT=1 -DENABLE_MODULE_EXTRAKEYS=1 -DENABLE_MODULE_RECOVERY=1 -DENABLE_MODULE_SCHNORRSIG=1 -DUSE_ASM_X86_64=1
  DEP_FILE = src/secp256k1/src/CMakeFiles/secp256k1.dir/secp256k1.c.o.d
  FLAGS = -O2 -g  -std=c90 -fPIC -fvisibility=hidden -pedantic -Wall -Wcast-align -Wcast-align=strict -Wextra -Wnested-externs -Wno-long-long -Wno-overlength-strings -Wno-unused-function -Wshadow -Wstrict-prototypes -Wundef
  INCLUDES = -I/home/runner/work/btx/btx/consent-native/build/src -I/home/runner/work/btx/btx/consent-product/src
  LAUNCHER = ccache /usr/bin/ccache 
